+assign reg_debug_req = 1'b0;
+assign reg_sleep_req = 1'b0;
+assign ndmreset_o = 1'b0;
+assign dm_avalon_s_readdata = 32'h0;
+assign dbgreg_avalon_s_readdata = 32'h0;
+assign dbgreg_avalon_s_readdatavalid = dbgreg_avalon_s_read & dbgreg_avalon_s_chipselect;
+assign dbgreg_avalon_s_writeresponsevalid = dbgreg_avalon_s_write & dbgreg_avalon_s_chipselect;
+assign dbgreg_avalon_s_response = 2'b00;
+assign dbgreg_avalon_s_waitrequest_n = 1'b1;
 
